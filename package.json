{
    "name": "sys_ven911",
    "version": "0.0.0",
    "description": "Sistema de Inventario VEN 9-1-1",
    "author": "VEN 9-1-1",
    "private": true,
    "type": "module",
    "main": "./electron/main.js",
    "scripts": {
        "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
        "build": "vite build && electron-builder --win",
        "build:installer": "vite build && electron-builder --win --x64 --publish never",
        "build:installer:32": "vite build && electron-builder --win --ia32 --publish never",
        "build:installer:all": "vite build && electron-builder --win --x64 --ia32 --publish never",
        "lint": "eslint .",
        "preview": "vite preview",
        "seed": "node electron/seed.js",
"seed:users": "node electron/seed-users.js"
    },
    "dependencies": {
        "@fontsource/geist-sans": "^5.2.5",
        "@hookform/resolvers": "^5.2.2",
        "@radix-ui/react-accordion": "^1.2.12",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-label": "^2.1.7",
        "@radix-ui/react-popover": "^1.1.15",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-separator": "^1.1.8",
        "@radix-ui/react-slot": "^1.2.3",
        "@radix-ui/react-switch": "^1.2.6",
        "@radix-ui/react-tabs": "^1.1.13",
        "@radix-ui/react-tooltip": "^1.2.8",
        "@tanstack/react-table": "^8.21.3",
        "bcryptjs": "^3.0.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^4.1.0",
        "jspdf": "^3.0.4",
        "jspdf-autotable": "^5.0.2",
        "lucide-react": "^0.548.0",
        "mysql2": "^3.15.3",
        "nanoid": "^5.1.6",
        "react": "^19.1.1",
        "react-day-picker": "^9.11.1",
        "react-dom": "^19.1.1",
        "react-hook-form": "^7.65.0",
        "recharts": "^2.15.4",
        "sequelize": "^6.37.7",
        "tailwind-merge": "^3.3.1",
        "xlsx": "^0.18.5",
        "xlsx-js-style": "^1.2.0",
        "zod": "^4.1.12",
        "zustand": "^5.0.8"
    },
    "devDependencies": {
        "@eslint/js": "^9.36.0",
        "@tailwindcss/vite": "^4.1.16",
        "@types/react": "^19.1.16",
        "@types/react-dom": "^19.1.9",
        "@vitejs/plugin-react": "^5.0.4",
        "concurrently": "^9.2.1",
        "electron": "^39.0.0",
        "electron-builder": "^26.0.12",
        "electron-vite": "^4.0.1",
        "eslint": "^9.36.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.22",
        "globals": "^16.4.0",
        "tailwindcss": "^4.1.16",
        "tw-animate-css": "^1.4.0",
        "vite": "npm:rolldown-vite@7.1.14",
        "wait-on": "^9.0.1"
    },
    "overrides": {
        "vite": "npm:rolldown-vite@7.1.14"
    },
    "build": {
        "appId": "com.ven911.sys-inventory",
        "productName": "Sistema de Inventario VEN 9-1-1",
        "directories": {
            "output": "dist-installer"
        },
        "files": [
            "dist/**/*",
            "dist-electron/**/*",
            "electron/**/*",
            "node_modules/**/*",
            "package.json"
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64",
                        "ia32"
                    ]
                }
            ],
            "icon": "build/icon.ico",
            "forceCodeSigning": false
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Sistema de Inventario VEN 9-1-1"
        }
    }
}
